# armGBA LCD Grid: the Game Boy Light, backlit.
shaders = 1
shader0 = shaders/armgba-lcd.glsl
filter_linear0 = true
scale_type0 = viewport

parameters = "GAP_SHARE;GAP_ACROSS;GAP_DOWN;GAP_RED;GAP_GREEN;GAP_BLUE;KEEP_BRIGHTNESS;UNLIT_RED;UNLIT_GREEN;UNLIT_BLUE;SHADOW;SHADOW_WAY"
GAP_SHARE = 0.15
GAP_ACROSS = 1
GAP_DOWN = 1
GAP_RED = 93
GAP_GREEN = 235
GAP_BLUE = 235
KEEP_BRIGHTNESS = 1
UNLIT_RED = 96
UNLIT_GREEN = 241
UNLIT_BLUE = 241
SHADOW = 0
SHADOW_WAY = 4
