scale0 = 1.0
float_framebuffer0 = true
feedback_pass = 0
shader1 = shaders/armgba-lcd.glsl
filter_linear1 = true
scale_type1 = viewport

parameters = "GHOSTING;INTERLACED;GHOST_DARKEN;GHOST_LIGHTEN;DRIVEN_SHARE;PIXEL_GAPS;GAP_SHARE;GAP_ACROSS;GAP_DOWN;GAP_RED;GAP_GREEN;GAP_BLUE;KEEP_BRIGHTNESS;UNLIT_RED;UNLIT_GREEN;UNLIT_BLUE;SHADOW;SHADOW_WAY;SHADOW_DISTANCE"
GHOSTING = 1
INTERLACED = 0
GHOST_DARKEN = 50
GHOST_LIGHTEN = 110
DRIVEN_SHARE = 0.8
PIXEL_GAPS = 1
GAP_SHARE = 0.25
GAP_ACROSS = 1
GAP_DOWN = 1
GAP_RED = 224
GAP_GREEN = 224
GAP_BLUE = 224
KEEP_BRIGHTNESS = 1
