# armGBA LCD Grid: the first Game Boy, gray screen.
shaders = 1
shader0 = shaders/armgba-lcd.glsl
filter_linear0 = true
scale_type0 = viewport

parameters = "GAP_SHARE;GAP_ACROSS;GAP_DOWN;GAP_RED;GAP_GREEN;GAP_BLUE;KEEP_BRIGHTNESS;UNLIT_RED;UNLIT_GREEN;UNLIT_BLUE;SHADOW;SHADOW_WAY"
GAP_SHARE = 0.25
GAP_ACROSS = 1
GAP_DOWN = 1
GAP_RED = 224
GAP_GREEN = 224
GAP_BLUE = 224
KEEP_BRIGHTNESS = 1
UNLIT_RED = 255
UNLIT_GREEN = 255
UNLIT_BLUE = 255
SHADOW = 0.2
SHADOW_WAY = 4
