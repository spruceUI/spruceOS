scale_type1 = viewport

parameters = "GHOSTING;INTERLACED;GHOST_DARKEN;GHOST_LIGHTEN;DRIVEN_SHARE;PIXEL_GAPS;GAP_SHARE;GAP_ACROSS;GAP_DOWN;GAP_RED;GAP_GREEN;GAP_BLUE;KEEP_BRIGHTNESS;UNLIT_RED;UNLIT_GREEN;UNLIT_BLUE;SHADOW;SHADOW_WAY;SHADOW_DISTANCE"
GHOSTING = 1
