# armGBA LCD Fast: the Game Boy Light, backlit.
shaders = 2
shader0 = shaders/armgba-lcd-fade-fast.glsl
filter_linear0 = false
scale_type0 = source
scale0 = 1.0
float_framebuffer0 = true
feedback_pass = 0
shader1 = shaders/armgba-lcd-fast.glsl
filter_linear1 = true
scale_type1 = viewport

parameters = "GHOSTING;INTERLACED;GHOST_DARKEN;GHOST_LIGHTEN;DRIVEN_SHARE;PIXEL_GAPS;GAP_SHARE;GAP_ACROSS;GAP_DOWN;GAP_RED;GAP_GREEN;GAP_BLUE;KEEP_BRIGHTNESS"
GHOSTING = 1
INTERLACED = 0
GHOST_DARKEN = 25
GHOST_LIGHTEN = 50
DRIVEN_SHARE = 0.8
PIXEL_GAPS = 1
GAP_SHARE = 0.15
GAP_ACROSS = 1
GAP_DOWN = 1
GAP_RED = 93
GAP_GREEN = 235
GAP_BLUE = 235
KEEP_BRIGHTNESS = 1
