# armGBA LCD Grid: the Game Boy Advance.
shaders = 1
shader0 = shaders/armgba-lcd.glsl
filter_linear0 = true
scale_type0 = viewport

parameters = "GAP_SHARE;GAP_ACROSS;GAP_DOWN;GAP_RED;GAP_GREEN;GAP_BLUE;KEEP_BRIGHTNESS;UNLIT_RED;UNLIT_GREEN;UNLIT_BLUE;SHADOW;SHADOW_WAY"
GAP_SHARE = 0.15
GAP_ACROSS = 0.75
GAP_DOWN = 0.75
GAP_RED = 0
GAP_GREEN = 0
GAP_BLUE = 0
KEEP_BRIGHTNESS = 1
UNLIT_RED = 0
UNLIT_GREEN = 0
UNLIT_BLUE = 0
SHADOW = 0
SHADOW_WAY = 4
