+#ifndef QT_NO_SSL
+    // Spruce Scraper: a handheld's firmware may hold no CA certificates and Qt 5 ignores
+    // SSL_CERT_FILE, so the bundle it names is added for every HTTPS request
+    const QString caFile = qEnvironmentVariable("SSL_CERT_FILE");
+    if (!caFile.isEmpty()) {
+        QSslConfiguration ssl = QSslConfiguration::defaultConfiguration();
+        if (ssl.addCaCertificates(caFile)) {
+            QSslConfiguration::setDefaultConfiguration(ssl);
+        }
+    }
+#endif
