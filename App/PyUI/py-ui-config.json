            "devices": ["MIYOO_A30", "MIYOO_FLIP", "TRIMUI_BRICK", "TRIMUI_SMART_PRO", "TRIMUI_SMART_PRO_S", "TRIMUI_BRICK_PRO", "RGB30", "ANBERNIC_RGXX", "MAGICX_A133P", "GKD_PIXEL2"]
        },
        {
