#!/bin/sh
# Apply the configured Fn key actions on the Brick line.
#
# spruce dispatches the Fn keys itself: fnkey_watchdog.sh watches the input node
# and, on a key-down, runs the absolute path found in
# /usr/trimui/fnkeys/f1key_launch (left) or f2key_launch (right). It execs that
# path with no arguments and requires it to be executable.
#
# Nothing has ever written those two files. The stock fn_editor app - now
# retired - wrote f1key.json / f2key.json instead, a format the watchdog does not
# read, so the Fn keys have silently done nothing. This is what finally connects
# them.
#
# Because the watchdog takes a bare path and no arguments, each key gets a tiny
# generated shim that calls fn-toggle with the chosen action. fn-toggle exists
# because these actions are written for the latching switch and expect 1 or 0;
# see the comment there.
#
# Run at boot from device_init with --now, and as each setting's changeCmd, where
# PyUI appends the newly-selected value as $1.
#
# Usage: apply-fnkey-action <f1|f2> [--now | <action label>]

. /mnt/SDCARD/spruce/scripts/helperFunctions.sh

FNKEYS_DIR="/usr/trimui/fnkeys"
SELF_DIR="/mnt/SDCARD/spruce/scripts/FN_Button"

KEY="$1"
case "$KEY" in
    f1) SETTING="fnF1Action" ;;
    f2) SETTING="fnF2Action" ;;
    *)  log_message "apply-fnkey-action: expected f1 or f2, got '$KEY'"; exit 1 ;;
esac

LAUNCH_FILE="$FNKEYS_DIR/${KEY}key_launch"
SHIM="$FNKEYS_DIR/${KEY}key_run.sh"

script_for_action() {
    case "$1" in
        "LED off")         echo "scene-rgb-led.sh" ;;
        "Quiet Mode")      echo "scene-quiet.sh" ;;
        "Silent Mode")     echo "scene-silent.sh" ;;
        "WiFi off")        echo "scene-wifi.sh" ;;
        "Joystick Toggle") echo "scene-joystick.sh" ;;
        *)                 echo "" ;;
    esac
}

apply_now() {
    action="$1"
    [ -n "$action" ] || action="$(get_config_value ".menuOptions.\"Button Settings\".${SETTING}.selected" "Nothing")"

    name="$(script_for_action "$action")"

    mkdir -p "$FNKEYS_DIR"
    rm -f "$LAUNCH_FILE" "$SHIM"

    if [ -z "$name" ] || [ ! -f "$SELF_DIR/$name" ]; then
        log_message "apply-fnkey-action: $KEY cleared (selected '$action')"
        return 0
    fi

    # The shim exists only so the watchdog's "one bare executable path" contract
    # can carry the two arguments fn-toggle needs.
    {
        echo "#!/bin/sh"
        echo "# Generated by apply-fnkey-action. Edits here are overwritten at boot."
        echo "exec \"$SELF_DIR/fn-toggle\" \"$name\" \"$KEY\""
    } > "$SHIM"
    chmod +x "$SHIM"

    echo "$SHIM" > "$LAUNCH_FILE"
    log_message "apply-fnkey-action: $KEY set to '$action' ($name)"
}

case "$2" in
    --now) apply_now ;;
    *)     apply_now "$2" ;;
esac
