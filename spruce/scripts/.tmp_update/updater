#!/bin/sh

# This entry point only needs to distinguish among MiyooMini, Flip, and devices that use runtime.sh.
INFO=$(cat /proc/cpuinfo 2> /dev/null)
case $INFO in
    *"0xd05"*) boot_route="Flip" ;; # RK3566; dArkMoss units never hit this exec path.
    *"SStar"*) boot_route="MiyooMini" ;;
    *)         boot_route="Other" ;;
esac
[ "$boot_route" = "Other" ] && [ -d /customer/app ] && boot_route="MiyooMini"

# The boot session supervisor (spruce/scripts/boot/session.sh) wraps runtime.sh
# with a crash-loop guard and a hand-off to the vendor UI. On the Flip it is
# opt-in through a flag while it is being validated, so a card that has not
# asked for it boots exactly as before.
SESSION=/mnt/SDCARD/spruce/scripts/boot/session.sh
use_session=0
case "$boot_route" in
    Flip) [ -e /mnt/SDCARD/spruce/flags/boot_session_enabled ] && use_session=1 ;;
esac

if [ "$boot_route" = "MiyooMini" ]; then
    /mnt/SDCARD/spruce/scripts/platform/miyoomini/miyoo_mini_startup.sh
elif [ "$use_session" = "1" ] && [ -f "$SESSION" ]; then
    SPRUCE_BOOT_PLATFORM="$boot_route" exec sh "$SESSION"
else
    cd /mnt/SDCARD/spruce/scripts
    ./runtime.sh
fi
