#!/bin/sh
# Apply the configured Smart Pro S switch action.
#
# The physical switch is dispatched by the stock trimui_scened daemon, which on
# every flip runs /usr/trimui/bin/scene.sh, and scene.sh runs every *.sh found in
# /usr/trimui/scene/. So the switch's behaviour is "whichever action script lives
# in that directory". This script makes that directory reflect the user's choice
# in Settings (Button Settings -> Switch action), so the switch is configurable
# without the stock fn_editor app (which also exposes left/right Fn keys that do
# not exist on this device).
#
# Run at boot (from device_init, with --now) and as the setting's changeCmd.
#
# changeCmd timing note: PyUI's set_menu_option() runs changeCmd BEFORE it writes
# the new value to spruce-config.json (it updates the value in memory, runs
# changeCmd, then save_config()). So when invoked as changeCmd we must NOT read
# the value immediately -- the file on disk still holds the previous selection.
# We background a short-delayed apply so the read happens after save_config() has
# landed. Cycling the dropdown fast just queues several delayed applies that all
# converge on the final saved value. At boot the value is already on disk, so
# --now applies synchronously without the delay.

. /mnt/SDCARD/spruce/scripts/helperFunctions.sh

SCENE_DIR="/usr/trimui/scene"
SELF_DIR="/mnt/SDCARD/spruce/smartpros/bin"

apply_now() {
    action="$(get_config_value '.menuOptions."Button Settings".switchAction.selected' "Nothing")"

    # Map the menu label to the spruce-native action script to install. All four
    # actions drive spruce's own systems rather than the stock scene scripts,
    # whose control numbering is wrong on this device: the stock quiet script
    # pokes tinymix control 9 (DACL DACR Swap, not volume) and the stock ledc.sh
    # derives brightness from a shmvar spruce never populates. scene-rgb-led.sh
    # drives the LEDs via rgb_led; scene-quiet.sh / scene-silent.sh go through
    # set_volume so the audio and the in-UI volume reading stay in sync;
    # scene-wifi.sh goes through enable_wifi / disable_wifi so the radio and
    # .wifi in SYSTEM_JSON stay in sync the same way.
    src=""; name=""
    case "$action" in
        "LED off")     src="$SELF_DIR/scene-rgb-led.sh"; name="scene-rgb-led.sh" ;;
        "Quiet Mode")  src="$SELF_DIR/scene-quiet.sh";   name="scene-quiet.sh" ;;
        "Silent Mode") src="$SELF_DIR/scene-silent.sh";  name="scene-silent.sh" ;;
        "WiFi off")    src="$SELF_DIR/scene-wifi.sh";    name="scene-wifi.sh" ;;
        "Nothing"|*)   src=""; name="" ;;
    esac

    mkdir -p "$SCENE_DIR"
    # Clear any previously installed action so only the current one runs.
    rm -f "$SCENE_DIR"/*.sh 2>/dev/null

    if [ -n "$src" ] && [ -f "$src" ]; then
        cp "$src" "$SCENE_DIR/$name"
        chmod +x "$SCENE_DIR/$name"
        log_message "apply-switch-action: switch set to '$action' ($name)"
    else
        log_message "apply-switch-action: switch action cleared (selected '$action')"
    fi
}

case "$1" in
    --now)
        # Boot path: value is already saved, apply immediately.
        apply_now
        ;;
    *)
        # changeCmd path: wait for PyUI's save_config() to write the new value.
        ( sleep 1; apply_now ) &
        ;;
esac
